import http.server, socketserver, urllib.request, os, sys, json

DIST = r'd:\成果云\frontend\dist'
API = 'http://127.0.0.1:5000'
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 3000

class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **kw):
        super().__init__(*a, directory=DIST, **kw)

    def do_API(self):
        # 代理 /api -> backend（保留 Authorization 等关键请求头，否则登录后的鉴权请求一律 401）
        url = API + self.path
        body = None
        if self.headers.get('Content-Length'):
            body = self.rfile.read(int(self.headers['Content-Length']))
        fwd_headers = {'Content-Type': self.headers.get('Content-Type', 'application/json')}
        if self.headers.get('Authorization'):
            fwd_headers['Authorization'] = self.headers['Authorization']
        req = urllib.request.Request(url, data=body, method=self.command, headers=fwd_headers)
        try:
            r = urllib.request.urlopen(req)
            data = r.read()
            self.send_response(r.status)
            self.send_header('Content-Type', r.headers.get('Content-Type', 'application/json'))
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except urllib.error.HTTPError as e:
            data = e.read()
            self.send_response(e.code)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except Exception as e:
            self.send_response(502)
            self.end_headers()
            self.wfile.write(str(e).encode())

    def do_GET(self):
        if self.path.startswith('/api/'):
            return self.do_API()
        # SPA fallback：非 /api 且目标文件不存在 → 均返回 index.html，交给前端路由接管
        try:
            translated = self.translate_path(self.path.split('?', 1)[0])
            is_real = os.path.isfile(translated)
        except Exception:
            is_real = False
        if not is_real:
            # SPA fallback 手动返回 index.html，并禁用缓存，防止旧 index.html 引用已不存在的旧 chunk
            try:
                with open(os.path.join(DIST, 'index.html'), 'rb') as f:
                    data = f.read()
            except Exception:
                self.send_response(404)
                self.end_headers()
                return
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.send_header('Content-Length', str(len(data)))
            self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
            self.end_headers()
            self.wfile.write(data)
            return
        # 真实静态资源（带构建哈希）保持默认，可强缓存
        return super().do_GET()

    def do_POST(self):
        return self.do_API()

    def do_PUT(self):
        return self.do_API()

    def do_DELETE(self):
        return self.do_API()

    def log_message(self, *a):
        return  # 静音

with socketserver.ThreadingTCPServer(('0.0.0.0', PORT), Handler) as httpd:
    print('static+proxy on', PORT, file=sys.stderr)
    httpd.serve_forever()